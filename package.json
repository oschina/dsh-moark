{
  "name": "dsh-moark",
  "version": "0.1.0",
  "type": "module",
  "description": "MoArk (模力方舟) provider onboarding for DeepSeek Harness",
  "homepage": "https://moark.com/docs/integrations/Development-Tools/deepseek-harness",
  "author": {
    "name": "MoArk (模力方舟)",
    "email": "gitee-ai@oschina.cn",
    "url": "https://moark.com"
  },
  "contributors": [
    {
      "name": "诺墨",
      "email": "normal@normalcoder.com",
      "url": "https://normalcoder.com"
    }
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oschina/dsh-moark.git"
  },
  "bugs": {
    "url": "https://github.com/oschina/dsh-moark/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "moark",
    "llm-provider",
    "openai-compatible"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/catalog.js && node --check lib/provider-config.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
